{
  "name": "kahocord",
  "productName": "KahoCord",
  "version": "3.9.3",
  "description": "KahoCord - connecte-toi à Discord avec le token de ton bot",
  "author": {
    "name": "kahodev",
    "url": "https://github.com/Hegowow"
  },
  "repository": {
    "url": "https://github.com/Hegowow/botcord/"
  },
  "license": "UNLICENSED",
  "main": "build/index.js",
  "scripts": {
    "test": "npm run build:ts && npm run start",
    "test:vencord": "npm run vencord && npm run test",
    "test:discohook": "npm run discohook && npm run test",
    "test:typescript": "tsc --noEmit",
    "build:ts": "tsc && tsc-alias",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "vencord": "tsx scripts/vencordBuild.ts",
    "discohook": "tsx scripts/discohookBuild.ts",
    "core:update": "tsx scripts/update.ts",
    "start": "electron .",
    "mac": "electron-builder -m",
    "win": "electron-builder -w",
    "linux": "electron-builder -l",
    "build:bin": "electron-builder",
    "build": "npm run build:deps && npm run build:ts && npm run build:bin",
    "build:deps": "npm run vencord && npm run discohook",
    "requirement": "npm install && tsx scripts/vencordClone.ts && tsx scripts/discohookClone.ts"
  },
  "keywords": [],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^4.17.23",
    "@types/http-proxy": "^1.17.17",
    "@types/ini": "^4.1.1",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^28.0.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "js-beautify": "^1.15.4",
    "jsdom": "^29.1.1",
    "pnpm": "^11.17.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@sapphire/snowflake": "^3.5.5",
    "@xmldom/xmldom": "^0.9.12",
    "dexie": "^4.4.4",
    "discord-api-types": "^0.38.50",
    "discord-protos": "^1.2.271",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "ini": "^6.0.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "murmurhash": "^2.0.1",
    "selfsigned": "^2.4.1",
    "undici": "^7.24.3"
  },
  "build": {
    "files": [
      "!docs",
      "!scripts",
      "!src",
      "!tsconfig.json",
      "!tsup.config.ts",
      "!.eslintrc.json",
      "!.gitattributes",
      "!.gitignore",
      "!.prettierrc.json",
      "!eslint.config.mjs",
      "!readme.md",
      "assets",
      "assets/editor",
      "build",
      "VencordExtension",
      "!Vencord",
      "!plugin",
      "!badges-plugin",
      "!server"
    ],
    "appId": "dev.kaho.kahocord",
    "productName": "KahoCord",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 kahodev",
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "icon": "./assets/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KahoCord a besoin du micro pour les appels vocaux.",
        "com.apple.security.device.audio-input": true,
        "NSCameraUsageDescription": "KahoCord a besoin de la caméra pour les appels vidéo.",
        "NSScreenCaptureUsageDescription": "KahoCord a besoin d'enregistrer l'écran pour le partage d'écran.",
        "com.apple.security.device.camera": true
      }
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "KahoCord",
          "GenericName": "Internet Messenger",
          "Type": "Application",
          "Categories": "Network;InstantMessaging;Chat;",
          "Keywords": "discord;bot;vencord;electron;chat;",
          "StartupWMClass": "KahoCord"
        }
      },
      "category": "Network",
      "icon": "./assets/icon.png",
      "executableName": "kahocord",
      "maintainer": "kahodev <noreply@kaho.fr>",
      "synopsis": "Client Discord par token (bot ou compte personnel)",
      "description": "KahoCord : la vraie interface Discord avec un token de bot ou de compte personnel.",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Hegowow",
        "repo": "botcord"
      }
    ],
    "asar": false,
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1"
      ]
    }
  },
  "private": true,
  "desktopName": "kahocord.desktop"
}
